# Copy this file to .env (git-ignored) and change what you like. Everything is optional.

# City used when you just say "weather" or "air quality"
POCKETPILOT_HOME_CITY=Hyderabad

# Your project's GitHub URL. Wikipedia only answers apps that give a contact link.
# POCKETPILOT_CONTACT=https://github.com/your-name/pocketpilot

# Local AI model for voice commands (run: ollama pull qwen3:4b)
POCKETPILOT_MODEL=qwen3:4b

# Model that can see the screen, for v3 (run: ollama pull qwen3.5:4b)
POCKETPILOT_VISION_MODEL=qwen3.5:4b

# Whisper speech model: base.en (fast) or small.en (more accurate, slower)
POCKETPILOT_WHISPER=base.en

# Amazon site used for "search Amazon for ..."
POCKETPILOT_AMAZON=www.amazon.in

# Optional free keys (no card needed). Leave empty to keep these skills off.
# News headlines: sign up at https://gnews.io
# POCKETPILOT_GNEWS_KEY=
# Live cricket scores: sign up at https://cricketdata.org
# POCKETPILOT_CRICKET_KEY=

# Names you message or call on WhatsApp, exactly as they appear in WhatsApp (comma-separated).
# Helps speech-to-text hear them right ("Amma", not "a month").
# POCKETPILOT_CONTACTS=Amma, Nanna, Kidduuu
